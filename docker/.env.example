# 复制成 .env 再填值（.env 已在 .gitignore 里，不会入库）

# MySQL root 密码。compose 里 nacos 连库也用这一个。
MYSQL_ROOT_PASSWORD=

# 想复用现有数据（不丢 nacos 元数据、seata 事务表、五个业务库、RabbitMQ 的 /hmall 和队列），
# 把两个匿名卷的长 id 填进来：
#   docker inspect -f '{{range .Mounts}}{{.Name}} -> {{.Destination}}{{end}}' sky-mysql
#   docker inspect -f '{{range .Mounts}}{{.Name}} -> {{.Destination}}{{end}}' rabbitmq
# 留空则新建空卷 hmall-mysql-data / hmall-rabbitmq-data，等于一台干净机器，要自己导 sql 和建 vhost。
MYSQL_DATA_VOLUME=
RABBITMQ_DATA_VOLUME=

# RabbitMQ 账号，和 Nacos 里 shared-mq.yaml 配置的那份要一致
RABBITMQ_USER=hmall
RABBITMQ_PASSWORD=123
